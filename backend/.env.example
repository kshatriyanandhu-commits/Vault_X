# Argus Vault Backend Environment Configuration

# Django Core
SECRET_KEY=argus-vault-production-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL or fallback to SQLite)
# To use PostgreSQL, set DATABASE_URL or POSTGRES_* credentials:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/argus_vault
# Or individually:
# POSTGRES_DB=argus_vault
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Superadmin Provisioning (used by createsuperadmin management command)
ADMIN_EMAIL=admin@argusvault.local
ADMIN_PASSWORD=ArgusAdmin2026!Secure
ADMIN_NAME=Argus Security Administrator
